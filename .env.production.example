# ==============================================================================
# KONFIGURASI PRODUCTION - PT BPR BANDA RAYA (CORE HRIS)
# ==============================================================================
# Salin berkas ini ke `.env` di server production:
#   cp .env.production.example .env
# Kemudian jalankan:
#   php artisan key:generate
# ==============================================================================

APP_NAME="Core HRIS PT BPR Banda Raya"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hris.bprbandaraya.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Keamanan Enkripsi Password (OJK Standard)
BCRYPT_ROUNDS=12

# Logging Berbasis Harian (Mencegah log membengkak, max retention 14-30 hari)
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# ==============================================================================
# DATABASE UTAMA (MySQL / MariaDB / PostgreSQL Server Bank)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpr_hris_prod
DB_USERNAME=hris_dbuser
DB_PASSWORD="GANTI_DENGAN_PASSWORD_DATABASE_KUAT_DAN_ACAK"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ==============================================================================
# MANAJEMEN SESI & KEAMANAN COOKIE (HTTPS WAJIB)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ==============================================================================
# CACHE, ANTREAN (QUEUE), & SISTEM BERKAS
# ==============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Jika menggunakan Redis Server:
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ==============================================================================
# SMTP SERVER SURAT RESMI BPR BANDA RAYA
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.bprbandaraya.com
MAIL_PORT=465
MAIL_USERNAME=notifikasi@bprbandaraya.com
MAIL_PASSWORD="GANTI_DENGAN_PASSWORD_EMAIL_NOTIFIKASI"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifikasi@bprbandaraya.com"
MAIL_FROM_NAME="Core HRIS BPR Banda Raya"

# ==============================================================================
# IMAP CPANEL WEBMAIL REKRUTMEN BPR BANDA RAYA
# ==============================================================================
IMAP_HOST=mail.bprbandaraya.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=karir@bprbandaraya.com
IMAP_PASSWORD="GANTI_DENGAN_PASSWORD_EMAIL_KARIR"

# ==============================================================================
# KEBIJAKAN KEHADIRAN (GEOFENCING GPS)
# ==============================================================================
# Di production, aktifkan geofencing untuk memastikan presensi staf berada di radius kantor cabang
GEOFENCING_ENABLED=true

